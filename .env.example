# Server Configuration
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# GitHub Integration
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_hmac_secret_key_here
TARGET_REPO=owner/repo

# Gemini LLM API
GEMINI_API_KEY=your_gemini_api_key_here

# Storage & FAISS Index Configuration
GCS_BUCKET=codelens-storage
LOCAL_INDEX_PATH=./data/indices/faiss_index.bin
LOCAL_METADATA_PATH=./data/indices/metadata.json
FEEDBACK_STORE_PATH=./data/feedback/reactions.jsonl
